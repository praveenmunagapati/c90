#include<math.h>
int maxarrayofints(int *arrayofints) {
    int max = 0;
    max = arrayofints[0] ;

    for (int i = 0;i<10;i++) {
        if (max<=arrayofints[i]) {
            max = arrayofints[i];
        }
    }
    arrayofints[9] = 500000;
    return max;
}
